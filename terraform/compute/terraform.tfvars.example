# terraform.tfvars 로 복사해서 쓴다 (.gitignore 대상)

# GitHub vars 의 TF_STATE_BUCKET 값
state_bucket = "<state-bucket-name>"

# GitHub secret 의 CERT_ARN 값
certificate_arn = "arn:aws:acm:ap-northeast-2:<ACCOUNT_ID>:certificate/<CERT_ID>"

# GitHub secret 의 HOSTED_ZONE_ID 값
hosted_zone_id = "<ZONE_ID>"

desired_count = 1
